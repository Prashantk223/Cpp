#include <stdio.h>
#include <stdlib.h>

struct node
{
    int data;
    struct node *link;
};

struct node *front = NULL, *rear = NULL;

void enqueue(int inData)
{
    struct node *temp = malloc(sizeof(struct node));
    temp->data = inData;

    if(front == NULL && rear == NULL)
    {
        front = rear = temp;
        rear->link = front;   // circular link
    }
    else
    {
        rear->link = temp;
        rear = temp;
        rear->link = front;
    }
}

int dequeue()
{
    int ret;
    
    if(front == NULL)
    {
        printf("Underflow\n");
        return -1;
    }
    
    if(front == rear)
    {
        ret = front->data;
        free(front);
        front = rear = NULL;
    }
    else
    {
        struct node *temp = front;
        ret = temp->data;
        front = front->link;
        rear->link = front;
        free(temp);
    }

    return ret;
}

