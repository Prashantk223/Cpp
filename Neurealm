bool circularLinkedList(struct node *head)
{
	struct node *fast = head;
	struct node *slow = head;
	
	while(fast && slow && fast->next)
	{
		fast = fast->next->next;
		slow = slow->next;
		
		if(fast == slow)
		{
			return true;
		}
		
	}
	return false;
}


