#include <stdio.h>

void InsertionSort(int arr[], int n)
{
	for(int i = 1; i < n; i++)
	{
		int j = i - 1;
		int temp = arr[i];
		while(j>=0 && arr[j] > temp)
		{
			arr[j+1] = arr[j];
			j--;
		}
		arr[j+1] = temp;
		
	}
	return 0;
}

void bubbleSort(int arr[], int n)
{
	int i, j;
	for(i = 0; i < n-1; i++)
	{
		for(j = 0; j < n - i - 1; j++)
		{
			if(arr[j] > arr[j + 1])
			{
				int temp = arr[j+1];
				arr[j+1] = arr[j];
				arr[j] = temp;
			}
		}
	}
}

void selectionSort(int data[], int len)
{
	int min = 0;
	for(int i = 0; i < len-1; i++)
	{
		min = i;
		for(int j = i+1; j < len; j++)
		{
			if(data[j] < data[min])
			{
				min = j;
			}
		}
		
		int temp = data[min];
		data[min] = data[i];
		data[i] = temp;
	}

}
